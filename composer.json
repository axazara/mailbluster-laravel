{
    "name": "axazara/mailbluster-laravel",
    "description": "This is simple PHP Package for Laravel to interact with MailBluster API.",
    "keywords": [
        "AxaZara",
        "laravel",
        "mailbluster",
        "mailbluster-laravel"
    ],
    "homepage": "https://github.com/axazara/mailbluster-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Elias Elimah",
            "email": "elias.elimah@axazara.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "axazara/php-cs": "^0.1",
        "insolita/unused-scanner": "^2.4",
        "nunomaduro/collision": "^6.0",
        "larastan/larastan": "^2.4",
        "orchestra/testbench": "^7.22",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "AxaZara\\MailBluster\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AxaZara\\MailBluster\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage",
        "sniff": "vendor/bin/php-cs-fixer fix -vvv --dry-run --show-progress=dots",
        "format": "vendor/bin/php-cs-fixer fix",
        "unused": "vendor/bin/unused_scanner unused-scanner.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AxaZara\\MailBluster\\MailBlusterServiceProvider"
            ],
            "aliases": {
                "MailBluster": "AxaZara\\MailBluster\\Facades\\MailBluster"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
